# 실제 값은 .env.local 에 넣는다. .env* 는 커밋 금지 (.gitignore 참조)

# S1 — Google Safe Browsing v4
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# 없어도 서비스는 동작하지만 해당 시그널이 "확인 못 함"으로 표시된다.
GOOGLE_SAFE_BROWSING_API_KEY=

# Sprint 2 — Claude 설명 레이어
ANTHROPIC_API_KEY=

# Sprint 3 — PostgreSQL (Supabase 또는 Neon)
DATABASE_URL=

# Sprint 2 — Upstash Redis (피드 저장 / rate limit)
# 콘솔의 "REST API" 섹션 → .env 탭에서 복사한다. TCP 접속 문자열이 아니다.
# 없으면 피드 대조는 "확인 못 함"이 되고 rate limit은 인메모리로 떨어진다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 피드 동기화 cron 보호용. 긴 랜덤 문자열이면 된다.
# Vercel Cron이 Authorization: Bearer <이 값> 으로 호출한다.
CRON_SECRET=
