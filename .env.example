# 실제 값은 .env.local 에 넣는다. .env* 는 커밋 금지 (.gitignore 참조)

# S1 — Google Safe Browsing v4
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# 없어도 서비스는 동작하지만 해당 시그널이 "확인 못 함"으로 표시된다.
GOOGLE_SAFE_BROWSING_API_KEY=

# Sprint 2 — Claude 설명 레이어
ANTHROPIC_API_KEY=

# Sprint 3 — PostgreSQL (Supabase 또는 Neon)
DATABASE_URL=

# Sprint 2 — Upstash Redis (피드 저장 / rate limit)
# 콘솔의 "REST API" 섹션 → .env 탭에서 복사한다. TCP 접속 문자열이 아니다.
# 없으면 피드 대조는 "확인 못 함"이 되고 rate limit은 인메모리로 떨어진다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 피드 동기화 cron 보호용. 긴 랜덤 문자열이면 된다.
# Vercel Cron이 Authorization: Bearer <이 값> 으로 호출한다.
CRON_SECRET=

# Sprint 3 — Supabase (REST API 경유. DB 연결 문자열은 쓰지 않는다)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Sprint 3 — Cloudflare Turnstile (신고 폼 남용 방지)
# 로컬은 Cloudflare 공개 테스트 키를 쓸 것: 1x00000000000000000000AA /
# 1x0000000000000000000000000000000AA. 운영에 테스트 키가 올라가면 아무나 통과한다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 관리자 검토 화면(/admin) 접근용. 없으면 화면이 503으로 닫힌다
ADMIN_PASSWORD=
